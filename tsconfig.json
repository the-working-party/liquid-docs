{
	"compilerOptions": {
		"target": "ES2023",
		"module": "node20",
		"lib": ["ES2023"],
		"types": ["node"],
		"outDir": "./",
		"rootDir": "./",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"noEmitOnError": true,
		"removeComments": false,
		"preserveConstEnums": true
	},
	"include": ["index.ts"],
	"exclude": ["node_modules", "pkg", "tests"]
}
